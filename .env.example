# Supabase Connection Credentials
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api

# 1. Project URL (found in Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Project Anon Key (public API key safe for client-side operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Optional: Service Role Key (ONLY for server-side elevated admin operations, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
